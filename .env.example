# ==========================================
# Plantilla de variables de entorno
# ==========================================
# Copia este archivo y rellena los valores reales:
#   cp .env.example .env.development
#   cp .env.example .env.production
#
# IMPORTANTE: Vite solo expone al navegador las variables con prefijo VITE_.
# Todo lo que pongas aqui viaja en el bundle publico: NUNCA incluyas claves
# privadas, tokens de servidor ni el access token de Mercado Pago.

# ---- API ----
# En desarrollo se usa "/api" y el proxy de Vite redirige a Django (:8000).
# En produccion, la URL absoluta del backend.
VITE_API_URL=/api

# ---- Mercado Pago ----
# Clave PUBLICA del Checkout API. Las de prueba empiezan por "TEST-",
# las productivas por "APP_USR-". La app detecta el modo sandbox por ese prefijo.
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Firebase Cloud Messaging (notificaciones push) ----
# Valores de la consola de Firebase → Configuracion del proyecto.
# Si se dejan vacios, la app arranca igual y simplemente no habilita el push.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave VAPID (Firebase → Cloud Messaging → Certificados push web).
VITE_FIREBASE_VAPID_KEY=
